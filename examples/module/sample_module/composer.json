{
    "name": "example/sample-module",
    "description": "A minimal example module for the Perfex CRM Stack Docker template.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5"
    },
    "autoload": {
        "psr-4": {
            "SampleModule\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SampleModule\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:int": "phpunit --testsuite integration",
        "check": "@test"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    }
}
