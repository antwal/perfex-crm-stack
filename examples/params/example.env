# A filled-in parameter file with neutral values, for a project that holds the example module of this template
# (examples/module/sample_module/) in its modules/ folder. Copy it, replace the names with your own, check it with
#   ./render.sh --check params.env
# render-test.sh (in the project folder) renders this very file, so keep it valid. No secrets: the database credentials are
# stack variables set in Portainer.

PROJECT_LABEL="My project"
STACK_NAME="myproject"

DOCKER_NETWORK="containers"
APP_HOST="myproject.perfexcrm.docker"
TOOLS_HOST="myproject-tools.perfexcrm.docker"
APP_URL="http://${APP_HOST}"

SSH_ALIAS="myproject-test"

REMOTE_ROOT="/srv/docker/perfexcrm/myproject"
TZ="UTC"
WEB_PHP_VERSION="8.4"
IMAGE_OWNER=""
TOOLS_PHP_VERSIONS="8.1 8.2 8.3 8.4 8.5"
TOOLS_NODE="0"
PASS_AUTHORIZATION="0"
TOOLS_CPUS="2"
TOOLS_MEM="2g"
TOOLS_PIDS="512"

WEB_EXTRA_PHP_VERSION=""
WEB_EXTRA_NAME=""
WEB_EXTRA_HOST=""

DEST_DIR="tools/docker"
LOCAL_TMP_DIR=".tmp"
SYNC_DIR="modules"
LOCK_FILE="/repo/.tmp/ci.lock"
SYNC_EXCLUDES=".git vendor/ node_modules/ .DS_Store *.zip *.sha256 .composer/ .phpunit.cache/"

MODULES_DIR="modules"
APP_TARGETS="app"
DEPLOY_MODULES="sample_module"
DEPLOY_EXCLUDES="/tests/ /phpunit* /.php-cs-fixer* .DS_Store"
DEV_MARKER=""
CI_MODULES="sample_module"
CI_CHECK_SCRIPT="check"
CI_STATIC_SCRIPT=""
STATIC_TOOLS_DIR=""

MATRIX_PHP_VERSIONS="8.3 8.4 8.5"
DEFAULT_PHP="8.4"
STATIC_PHP=""
DEPLOY_PHP=""

MAILPIT_URL="http://mailpit.docker:8025"
MAILPIT_SMTP_HOST="mailpit.docker"
MAILPIT_SMTP_PORT="1025"

INCLUDE_AI="1"
