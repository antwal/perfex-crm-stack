# Stack variables for Portainer, for the stack "{{STACK_NAME}}": Stacks > the stack > Environment variables > "Load variables from .env file".
# Written by render.sh on {{RENDER_DATE}} from {{RENDER_SOURCE}}: change the parameter file and render again.
#
# NO SECRETS IN THIS FILE. The four database variables are not here on purpose: add them by hand in the Portainer
# interface (the stack refuses to start without them):
#   PERFEX_DB_HOST  PERFEX_DB_NAME  PERFEX_DB_USER  PERFEX_DB_PASSWORD
# Optional variables that are not listed because the defaults are right: SSH_PORT (the default is 2222; if you set it,
# set the same Port in ~/.ssh/config) and SSH_TCP_FORWARDING (1 allows "ssh -L"). With stack/web-extra.yml the three
# WEB_EXTRA_* variables below are set too.
STACK_NAME={{STACK_NAME}}
REMOTE_ROOT={{REMOTE_ROOT}}
DOCKER_NETWORK={{DOCKER_NETWORK}}
APP_HOST={{APP_HOST}}
TOOLS_HOST={{TOOLS_HOST}}
APP_URL={{APP_URL}}
WEB_IMAGE={{WEB_IMAGE}}
TOOLS_IMAGE={{TOOLS_IMAGE}}
TZ={{TZ}}
PASS_AUTHORIZATION={{PASS_AUTHORIZATION}}
TOOLS_CPUS={{TOOLS_CPUS}}
TOOLS_MEM={{TOOLS_MEM}}
TOOLS_PIDS={{TOOLS_PIDS}}
MAILPIT_URL={{MAILPIT_URL}}
MAILPIT_SMTP_HOST={{MAILPIT_SMTP_HOST}}
MAILPIT_SMTP_PORT={{MAILPIT_SMTP_PORT}}
WEB_EXTRA_IMAGE={{WEB_EXTRA_IMAGE}}
WEB_EXTRA_NAME={{WEB_EXTRA_NAME}}
WEB_EXTRA_HOST={{WEB_EXTRA_HOST}}
