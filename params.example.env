# Parameters of the Perfex CRM Stack Docker template. A bash file with assignments only: render.sh loads it with `source`, so a value can
# reuse one defined above it (APP_URL uses APP_HOST). Because it is sourced, treat it like code.
# NO SECRETS HERE: the database credentials are stack variables you set in the Portainer interface.
#
# Copy this file to params.env (it is not meant to be committed), edit it, then:
#   ./render.sh --check params.env          validates everything and writes nothing
#   ./render.sh params.env <project root>   writes the project folder <project root>/<DEST_DIR>
#
# Only the six values marked REQUIRED have no default. Every other line shows its default: delete it or change it.
# The values below are neutral examples: replace names, folders and DNS names with the ones of your server.

# ---- Identity (REQUIRED) -----------------------------------------------------------------------------------------------
PROJECT_LABEL="My project"                       # human-readable name, used in titles and notes
STACK_NAME="myproject"                           # Portainer stack name; containers: <STACK_NAME> (web) and <STACK_NAME>-tools

# ---- Network and DNS ---------------------------------------------------------------------------------------------------
# An external Docker network that already exists on the server, with DNS names that your Mac resolves too.
DOCKER_NETWORK="containers"
APP_HOST="myproject.perfexcrm.docker"            # REQUIRED. DNS name of the web container
TOOLS_HOST="myproject-tools.perfexcrm.docker"    # REQUIRED. DNS name of the tools container (SSH)
APP_URL="http://${APP_HOST}"                     # how your Mac, the tests and the scripts reach the application

# ---- SSH ---------------------------------------------------------------------------------------------------------------
# User www-data (uid 33), key only, port 2222. The alias is the Host entry of ~/.ssh/config and the key file ~/.ssh/<alias>.
SSH_ALIAS="myproject-test"                       # REQUIRED

# ---- Server ------------------------------------------------------------------------------------------------------------
REMOTE_ROOT="/srv/docker/perfexcrm/myproject"    # REQUIRED. Folder of the stack on the server: app/, repo/, tools/, build/
TZ="UTC"
WEB_PHP_VERSION="8.4"                            # PHP version of the web image you build (Perfex 3.4 needs 8.1 or later)
IMAGE_OWNER=""                                   # optional owner or registry prefix of the two images you build, for example "myowner"
                                                 # or "registry.example.com/team": the names become <IMAGE_OWNER>/perfex-web:<WEB_PHP_VERSION>
                                                 # and <IMAGE_OWNER>/perfex-tools:<first>-<last of TOOLS_PHP_VERSIONS>; empty = no prefix;
                                                 # lowercase letters, digits and . _ : / -, at least two characters, first and last a letter or a digit
# WEB_IMAGE="perfex-web:8.4"                     # only to use another name (your own web image, another tag); the default follows IMAGE_OWNER.
                                                 # With your own web image you do not build web/Dockerfile: the image is yours
# TOOLS_IMAGE="perfex-tools:8.1-8.5"             # the same for the tools image
TOOLS_PHP_VERSIONS="8.1 8.2 8.3 8.4 8.5"         # PHP versions installed in the tools image (build argument PHP_VERSIONS); blanks are squeezed to one
                                                 # blank, and the tag always names both ends: one version, 8.4, gives perfex-tools:8.4-8.4
TOOLS_NODE="0"                                   # 1 = also install Node in the tools image (about 100 MB)
PASS_AUTHORIZATION="0"                           # 1 = the web container hands the Authorization header to PHP (REST APIs)
TOOLS_CPUS="2"                                   # resource limits of the tools container
TOOLS_MEM="2g"
TOOLS_PIDS="512"

# ---- Second web instance (optional: only if you use stack/web-extra.yml) -------------------------------------------------
# The image [<IMAGE_OWNER>/]perfex-web:<WEB_EXTRA_PHP_VERSION> must be built first (portainer.env then carries it as WEB_EXTRA_IMAGE).
# Leave all three empty if you do not use it.
WEB_EXTRA_PHP_VERSION=""                         # for example 8.5
WEB_EXTRA_NAME=""                                # container name, for example myproject-php85
WEB_EXTRA_HOST=""                                # DNS name, for example myproject-php85.perfexcrm.docker

# ---- The project folder written by render.sh and the code it works on ----------------------------------------------------
DEST_DIR="tools/docker"                          # folder to write, relative to the project root
LOCAL_TMP_DIR=".tmp"                             # temporary files of the project, relative to the project root
SYNC_DIR="modules"                               # folder of the project mirrored to /repo/<SYNC_DIR> on the server; holds the modules
LOCK_FILE="/repo/.tmp/ci.lock"                   # lock file on the server (inside /repo): one heavy job at a time
SYNC_EXCLUDES=".git vendor/ node_modules/ .DS_Store *.zip *.sha256 .composer/ .phpunit.cache/"   # rsync excludes of sync.sh

# ---- Applications and modules --------------------------------------------------------------------------------------------
MODULES_DIR="modules"                            # where modules live inside the application: /app/<MODULES_DIR>/<module>
APP_TARGETS="app"                                # application folders deploy.sh may write to (the first is the default); "app-extra" with web-extra.yml
DEPLOY_MODULES=""                                # module names deploy.sh accepts (closed list). Empty = every <SYNC_DIR>/<name>/<name>.php found
DEPLOY_EXTRA=""                                  # modules that live deeper than <SYNC_DIR>/<name>/ (a sample module inside another module, say): blank-separated
                                                 # pairs <folder relative to SYNC_DIR>:<name>, for example "mymodule/examples/demo_notes:demo_notes". The folder must
                                                 # hold <name>.php; <name> is the folder deploy.sh writes in the application and the word you give it. Empty = none
DEPLOY_EXCLUDES="/tests/ /phpunit* /.php-cs-fixer* .DS_Store"   # rsync excludes when a module is copied into the application
DEV_MARKER=""                                    # empty file created in the deployed module folder (for modules with a development mode); empty = none
CI_MODULES=""                                    # modules of the matrix in ci-local.sh. Empty = every <SYNC_DIR>/<name>/<name>.php found
CI_CHECK_SCRIPT="check"                          # composer script run for every module and PHP version
CI_STATIC_SCRIPT=""                              # composer script for static analysis, run once on STATIC_PHP; empty = skip
STATIC_TOOLS_DIR=""                              # folder inside SYNC_DIR with a composer.json of shared tools (installed once); empty = none

# ---- PHP versions used by the scripts ------------------------------------------------------------------------------------
MATRIX_PHP_VERSIONS="8.3 8.4 8.5"                # ci-local.sh runs every module on each of these (subset of TOOLS_PHP_VERSIONS)
DEFAULT_PHP="8.4"                                # PHP used by deploy.sh and by static analysis (must be in TOOLS_PHP_VERSIONS)
STATIC_PHP=""                                    # empty = DEFAULT_PHP
DEPLOY_PHP=""                                    # empty = DEFAULT_PHP

# ---- Optional external services (empty = not present) ----------------------------------------------------------------------
MAILPIT_URL=""                                   # web interface and API (/api/v1/messages), for example http://mailpit.docker:8025
MAILPIT_SMTP_HOST=""                             # for example mailpit.docker
MAILPIT_SMTP_PORT=""                             # for example 1025

# ---- AI agents ----------------------------------------------------------------------------------------------------------------
INCLUDE_AI="1"                                   # 1 = also write <DEST_DIR>/ai/ (prompts, CLAUDE.md section, memory note); 0 = no
